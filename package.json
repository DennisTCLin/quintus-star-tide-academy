{
  "name": "quintus-ocean-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:zhuyin",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run audit:content && npm run build:zhuyin && npm run check:pronunciation && tsc -b && vite build && npm run build:server",
    "build:zhuyin": "node scripts/pack-zhuyin.mjs",
    "start": "node server.mjs",
    "test": "vitest run",
    "build:server": "esbuild server/game.ts --bundle --platform=node --format=esm --outfile=build/game.mjs",
    "check:pronunciation": "node scripts/check-pronunciation.mjs && node scripts/pack-zhuyin.mjs --check",
    "audit:content": "node scripts/content-audit.mjs",
    "audit:content:inventory": "node scripts/content-audit.mjs --inventory"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2"
  }
}

FROM node:22.12-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY dist ./dist
COPY preserved-assets.json restore-assets.mjs ./
RUN node restore-assets.mjs && rm preserved-assets.json restore-assets.mjs
COPY server ./server
COPY build ./build
COPY server.mjs ./server.mjs
COPY src/data ./src/data
EXPOSE 3000
CMD ["node", "server.mjs"]
